{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Adlist Parser",
      "type": "debugpy",
      "request": "launch",
      "module": "adparser",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [],
      "justMyCode": false
    },
    {
      "name": "Adlist Parser: Remove Duplicates",
      "type": "debugpy",
      "request": "launch",
      "module": "adparser",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["--remove-duplicates"],
      "justMyCode": false
    },
    {
      "name": "Adlist Parser: Check Conflicts",
      "type": "debugpy",
      "request": "launch",
      "module": "adparser",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["--check-conflicts"],
      "justMyCode": false
    },
    {
      "name": "Tests with Coverage",
      "type": "debugpy",
      "request": "launch",
      "noDebug": true,
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [],
      "justMyCode": false
    },
    {
      "name": "Pylint: adparser",
      "type": "debugpy",
      "request": "launch",
      "noDebug": true,
      "module": "pylint",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["adparser", "tests"],
      "justMyCode": false
    },
    {
      "name": "Jekyll: Serve Docs",
      "type": "node-terminal",
      "request": "launch",
      "command": "bundle exec jekyll serve --livereload --config _config.yml,_config_dev.yml",
      "cwd": "${workspaceFolder}/docs"
    }
  ]
}
